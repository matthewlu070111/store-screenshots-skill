      "layout": "hero",
      "shots": [
        {
          "image": "./assets/screens/04-tablet.png",
          "theme": "mint",
          "layout": "hero",
          "eyebrow": {
            "en-US": "BUILT FOR IPAD",
            "zh-CN": "为 iPad 而生"
          },
          "title": {
