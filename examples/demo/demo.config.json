          "detailZoom": 1.05,
          "detailFocus": [
            0.24,
            0.54
          ],
          "eyebrow": {
            "en-US": "INSIGHTS",
            "zh-CN": "每周回顾"
          },
          "title": {
            "en-US": "See every\n{focused} minute",
            "zh-CN": "看见每一次\n{投入}"
