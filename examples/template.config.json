        {
          "image": "./screens/03-result.png",
          "theme": "paper",
          "layout": "detail",
          "detailFocus": [0.5, 0.55],
          "detailZoom": 1.4,
          "eyebrow": { "zh-CN": "结果与回顾", "en-US": "RESULTS" },
          "title": {
            "zh-CN": "每一次投入，\n都{看得见}",
            "en-US": "See every\n{focused} minute"
          },
          "subtitle": {
            "zh-CN": "用真实数据或结果截图收尾。",
            "en-US": "Close with a real result or insight."
          }
        }
      ]
    },
    {
      "name": "iphone-6.3",
