    {
      "name": "iphone-6.9",
      "device": "iphone-6.9",
      "shots": [
        {
          "image": "./screens/01-home.png",
          "eyebrow": { "zh-CN": "核心体验", "en-US": "THE CORE EXPERIENCE" },
          "title": {
            "zh-CN": "一句话说清\n{为什么值得下载}",
            "en-US": "One line on why\n{it is worth it}"
