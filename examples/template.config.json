          "subtitle": {
            "zh-CN": "用真实界面展示你最想强调的能力。",
            "en-US": "Show the one capability that matters most."
          }
        },
        {
          "image": "./screens/02-flow.png",
          "theme": "sunset",
          "layout": "split",
          "eyebrow": { "zh-CN": "关键流程", "en-US": "THE FLOW" },
          "title": {
            "zh-CN": "把复杂的事，\n变得{简单}",
